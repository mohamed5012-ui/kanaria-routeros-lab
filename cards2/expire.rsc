{
{ :local nm 0; { :local a [/system clock get date]; :local b [/system clock get time]; :local y 0; :local o 0; :local d 0; :if ([:pick $a 4 5] = "-") do={ :set y [:tonum [:pick $a 0 4]]; :set o ([:tonum ("1" . [:pick $a 5 7])] - 100); :set d ([:tonum ("1" . [:pick $a 8 10])] - 100) } else={ :set o ([:find "janfebmaraprmayjunjulaugsepoctnovdec" [:pick $a 0 3]] / 3 + 1); :set d ([:tonum ("1" . [:pick $a 4 6])] - 100); :set y [:tonum [:pick $a 7 11]] }; :if ($o <= 2) do={ :set y ($y - 1); :set o ($o + 9) } else={ :set o ($o - 3) }; :local e ($y / 400); :local v ($y - $e * 400); :set nm ((($e * 146097 + $v * 365 + $v / 4 - $v / 100 + (153 * $o + 2) / 5 + $d - 1 - 719468) * 1440) + ([:tonum ("1" . [:pick $b 0 2])] - 100) * 60 + ([:tonum ("1" . [:pick $b 3 5])] - 100)) }; :foreach u in=[/ip hotspot user find where disabled=no and comment~"^Kanary_C [0-9a-z]+;.*; k=[0-9]+"] do={ :do { :local c [/ip hotspot user get $u comment]; :local p [:find $c "; k="]; :local e [:find $c ";" ($p + 1)]; :if ([:typeof $e] = "nil") do={ :set e [:len $c] }; :local k [:tonum [:pick $c ($p + 4) $e]]; :if (([:typeof $k] = "num") and ($k <= $nm)) do={ :local n [/ip hotspot user get $u name]; /ip hotspot user set $u disabled=yes comment=([:pick $c 0 $p] . "; x=" . [:pick $c ($p + 4) [:len $c]]); :do { /ip hotspot active remove [find where user=$n] } on-error={} } } on-error={} } }
}
