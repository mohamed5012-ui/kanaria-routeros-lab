# Kanaria hotspot cards (generated). Only users with the comment Kanary_C are touched.
{
:global kanariaBeat; :if ([:typeof $kanariaBeat] != "num") do={ :set kanariaBeat 0 };
:local up true; :local t "";
:do { :local f [/ip hotspot user profile find where name="Kanary_P9M"]; :if ([:len $f] = 0) do={ /ip hotspot user profile add name="Kanary_P9M" rate-limit="512k/1M" shared-users=2 add-mac-cookie=yes mac-cookie-timeout=30d00:00:00 } else={ /ip hotspot user profile set $f rate-limit="512k/1M" shared-users=2 add-mac-cookie=yes mac-cookie-timeout=30d00:00:00 } } on-error={ :log warning "Kanaria cards: profile Kanary_P9M failed" };
:do { :local f [/ip hotspot user profile find where name="Kanary_P7"]; :if ([:len $f] = 0) do={ /ip hotspot user profile add name="Kanary_P7" rate-limit="2M/4M" shared-users=1 add-mac-cookie=no } else={ /ip hotspot user profile set $f rate-limit="2M/4M" shared-users=1 add-mac-cookie=no } } on-error={ :log warning "Kanaria cards: profile Kanary_P7 failed" };
:do { :local f [/ip hotspot user profile find where name="Kanary_P7M"]; :if ([:len $f] = 0) do={ /ip hotspot user profile add name="Kanary_P7M" rate-limit="2M/4M" shared-users=1 add-mac-cookie=yes mac-cookie-timeout=03:00:00 } else={ /ip hotspot user profile set $f rate-limit="2M/4M" shared-users=1 add-mac-cookie=yes mac-cookie-timeout=03:00:00 } } on-error={ :log warning "Kanaria cards: profile Kanary_P7M failed" };
:do { :foreach p in=[/ip hotspot profile find] do={ :local lb [/ip hotspot profile get $p login-by]; :local s ""; :local has false; :foreach x in=$lb do={ :if ($x = "mac-cookie") do={ :set has true }; :set s ($s . $x . ",") }; :if ((!$has) and ([:len $lb] > 0)) do={ /ip hotspot profile set $p login-by=($s . "mac-cookie") } } } on-error={ :log warning "Kanaria cards: mac-cookie failed" };
:do { :local f [/ip hotspot user find where name="30070699"]; :if ([:len $f] = 0) do={ /ip hotspot user add name="30070699" password="30070699" profile="Kanary_P9M" limit-bytes-total=536870912 limit-uptime=3d00:00:00 comment="Kanary_C"; :set t ($t . "a1,") } else={ :if ([/ip hotspot user get [:pick $f 0] comment] = "Kanary_C") do={ :set t ($t . "a1,") } else={ :set t ($t . "x1,") } } } on-error={ :set t ($t . "e1,") }
:do { :local f [/ip hotspot user find where name="29889099"]; :if ([:len $f] = 0) do={ /ip hotspot user add name="29889099" password="ax6f6d5j" profile="Kanary_P7" limit-bytes-total=1073741824 limit-uptime=01:30:00 comment="Kanary_C"; :set t ($t . "a2,") } else={ :if ([/ip hotspot user get [:pick $f 0] comment] = "Kanary_C") do={ :set t ($t . "a2,") } else={ :set t ($t . "x2,") } } } on-error={ :set t ($t . "e2,") }
:do { :local f [/ip hotspot user find where name="ownuser3"]; :if ([:len $f] = 0) do={ /ip hotspot user add name="ownuser3" password="ownuser3" profile="Kanary_P7" limit-bytes-total=1073741824 limit-uptime=01:30:00 comment="Kanary_C"; :set t ($t . "a3,") } else={ :if ([/ip hotspot user get [:pick $f 0] comment] = "Kanary_C") do={ :set t ($t . "a3,") } else={ :set t ($t . "x3,") } } } on-error={ :set t ($t . "e3,") }
:do { :local f [/ip hotspot user find where name="40961997"]; :if ([:len $f] = 0) do={ /ip hotspot user add name="40961997" password="jqzkrrcv" profile="Kanary_P7" limit-bytes-total=1073741824 limit-uptime=01:30:00 comment="Kanary_C"; :set t ($t . "a4,") } else={ :if ([/ip hotspot user get [:pick $f 0] comment] = "Kanary_C") do={ :set t ($t . "a4,") } else={ :set t ($t . "x4,") } } } on-error={ :set t ($t . "e4,") }
:do { :local f [/ip hotspot user find where name="51881311"]; :if ([:len $f] = 0) do={ /ip hotspot user add name="51881311" password="51881311" profile="Kanary_P7M" limit-bytes-total=1073741824 limit-uptime=01:30:00 comment="Kanary_C"; :set t ($t . "a5,") } else={ :if ([/ip hotspot user get [:pick $f 0] comment] = "Kanary_C") do={ :set t ($t . "a5,") } else={ :set t ($t . "x5,") } } } on-error={ :set t ($t . "e5,") }
:set t ($t . "\n"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e2da7bd190d53e8d50e9a5e9a643aa3a&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e2da7bd190d53e8d50e9a5e9a643aa3a&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
:foreach u in=[/ip hotspot user find where comment="Kanary_C"] do={ :do { :local n [/ip hotspot user get $u name]; :local bi [/ip hotspot user get $u bytes-in]; :local bo [/ip hotspot user get $u bytes-out]; :local ut [/ip hotspot user get $u uptime]; :set t ($t . "u" . $n . ":" . ($bi + $bo) . ":" . [:tostr $ut] . ",") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e2da7bd190d53e8d50e9a5e9a643aa3a&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e2da7bd190d53e8d50e9a5e9a643aa3a&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:foreach h in=[/ip hotspot active find] do={ :do { :local n [/ip hotspot active get $h user]; :set t ($t . "o" . $n . ",") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e2da7bd190d53e8d50e9a5e9a643aa3a&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e2da7bd190d53e8d50e9a5e9a643aa3a&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:set t ($t . "end"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e2da7bd190d53e8d50e9a5e9a643aa3a&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e2da7bd190d53e8d50e9a5e9a643aa3a&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
}
