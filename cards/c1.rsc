:do { :foreach p in=[/ip hotspot profile find] do={ :local lb [/ip hotspot profile get $p login-by]; :local s ""; :local has false; :foreach x in=$lb do={ :if ($x = "mac-cookie") do={ :set has true }; :set s ($s . $x . ",") }; :if ((!$has) and ([:len $lb] > 0)) do={ /ip hotspot profile set $p login-by=($s . "mac-cookie") } } } on-error={ :log warning "Kanaria cards: mac-cookie failed" };
