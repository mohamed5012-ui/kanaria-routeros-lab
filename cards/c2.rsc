# Kanaria hotspot cards (generated). Only users with the comment Kanary_C are touched.
{
:global kanariaBeat; :if ([:typeof $kanariaBeat] != "num") do={ :set kanariaBeat 0 };
:local up true; :local t "";
:do { :foreach u in=[/ip hotspot user find where name="86304022" and comment="Kanary_C"] do={ :do { /ip hotspot active remove [find where user="86304022"] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r11,") } on-error={ :set t ($t . "e11,") }
:do { :foreach u in=[/ip hotspot user find where name="85670768" and comment="Kanary_C"] do={ :do { /ip hotspot active remove [find where user="85670768"] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r12,") } on-error={ :set t ($t . "e12,") }
:do { :foreach u in=[/ip hotspot user find where name="91436890" and comment="Kanary_C"] do={ /ip hotspot user set $u disabled=yes; :do { /ip hotspot active remove [find where user="91436890"] } on-error={} }; :set t ($t . "d21,") } on-error={ :set t ($t . "e21,") }
:do { :foreach u in=[/ip hotspot user find where name="13343901" and comment="Kanary_C"] do={ /ip hotspot user set $u disabled=yes; :do { /ip hotspot active remove [find where user="13343901"] } on-error={} }; :set t ($t . "d22,") } on-error={ :set t ($t . "e22,") }
:set t ($t . "\n"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=2f0ecf34c36e080ec635eda27c7d9053&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=2f0ecf34c36e080ec635eda27c7d9053&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
:foreach u in=[/ip hotspot user find where comment="Kanary_C"] do={ :do { :local n [/ip hotspot user get $u name]; :local bi [/ip hotspot user get $u bytes-in]; :local bo [/ip hotspot user get $u bytes-out]; :local ut [/ip hotspot user get $u uptime]; :set t ($t . "u" . $n . ":" . ($bi + $bo) . ":" . [:tostr $ut] . ",") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=2f0ecf34c36e080ec635eda27c7d9053&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=2f0ecf34c36e080ec635eda27c7d9053&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:foreach h in=[/ip hotspot active find] do={ :do { :local n [/ip hotspot active get $h user]; :set t ($t . "o" . $n . ",") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=2f0ecf34c36e080ec635eda27c7d9053&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=2f0ecf34c36e080ec635eda27c7d9053&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:set t ($t . "end"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=2f0ecf34c36e080ec635eda27c7d9053&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=2f0ecf34c36e080ec635eda27c7d9053&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
}
