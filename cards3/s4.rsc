# Kanaria hotspot cards (generated). Only users whose comment starts with Kanary_C are touched.
{
:global kanariaBeat; :if ([:typeof $kanariaBeat] != "num") do={ :set kanariaBeat 0 };
:local up true; :local t "";
:do { /system clock set date="2026-10-21" time="18:47:55" } on-error={ :log warning "Kanaria cards: clock not set" };
:do { /system scheduler remove [find where name="Kanaria-expire"] } on-error={};
:do { :if ([:len [/ip hotspot user find where profile="Lab MAC - 2026-10-21 - MAC"]] = 0) do={ /ip hotspot user profile remove [find where name="Lab MAC - 2026-10-21 - MAC"] } } on-error={}; :set t ($t . "g6,");
:do { :if ([:len [/ip hotspot user find where profile="Lab Created - 2026-10-21"]] = 0) do={ /ip hotspot user profile remove [find where name="Lab Created - 2026-10-21"] } } on-error={}; :set t ($t . "g7,");
:set t ($t . "\n"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e9eccbb9eda51acf07dadbfc2d3a7f78&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e9eccbb9eda51acf07dadbfc2d3a7f78&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
:foreach u in=[/ip hotspot user find where comment~"^Kanary_C"] do={ :do { :local c [/ip hotspot user get $u comment]; :local n [/ip hotspot user get $u name]; :local bi [/ip hotspot user get $u bytes-in]; :local bo [/ip hotspot user get $u bytes-out]; :local ut [/ip hotspot user get $u uptime]; :local ds [/ip hotspot user get $u disabled]; :set t ($t . "v" . $n . "|" . ($bi + $bo) . "|" . [:tostr $ut] . "|" . [:tostr $ds] . "|" . $c . "\n") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e9eccbb9eda51acf07dadbfc2d3a7f78&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e9eccbb9eda51acf07dadbfc2d3a7f78&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:foreach h in=[/ip hotspot active find] do={ :do { :set t ($t . "o" . [/ip hotspot active get $h user] . "\n") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e9eccbb9eda51acf07dadbfc2d3a7f78&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e9eccbb9eda51acf07dadbfc2d3a7f78&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:set t ($t . "c" . [/system clock get date] . "|" . [/system clock get time] . "|" . [:tostr [/system clock get gmt-offset]] . "\n");
:set t ($t . "end"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e9eccbb9eda51acf07dadbfc2d3a7f78&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=e9eccbb9eda51acf07dadbfc2d3a7f78&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
}
