# Kanaria hotspot cards (generated). Only users whose comment starts with Kanary_C are touched.
{
:global kanariaBeat; :if ([:typeof $kanariaBeat] != "num") do={ :set kanariaBeat 0 };
:local up true; :local t "";
:do { /system clock set date="2026-10-21" time="19:05:24" } on-error={ :log warning "Kanaria cards: clock not set" };
:do { :foreach p in=[/ip hotspot profile find] do={ :local lb [/ip hotspot profile get $p login-by]; :local s ""; :local has false; :foreach x in=$lb do={ :if ($x = "mac") do={ :set has true }; :set s ($s . $x . ",") }; :if ((!$has) and ([:len $lb] > 0)) do={ /ip hotspot profile set $p login-by=($s . "mac") } } } on-error={ :log warning "Kanaria cards: login-by mac failed" };
:do { :local ev "{ :local nm 0; { :local a [/system clock get date]; :local b [/system clock get time]; :local y 0; :local o 0; :local d 0; :if ([:pick \$a 4 5] = \"-\") do={ :set y [:tonum [:pick \$a 0 4]]; :set o ([:tonum (\"1\" . [:pick \$a 5 7])] - 100); :set d ([:tonum (\"1\" . [:pick \$a 8 10])] - 100) } else={ :set o ([:find \"janfebmaraprmayjunjulaugsepoctnovdec\" [:pick \$a 0 3]] / 3 + 1); :set d ([:tonum (\"1\" . [:pick \$a 4 6])] - 100); :set y [:tonum [:pick \$a 7 11]] }; :if (\$o <= 2) do={ :set y (\$y - 1); :set o (\$o + 9) } else={ :set o (\$o - 3) }; :local e (\$y / 400); :local v (\$y - \$e * 400); :set nm (((\$e * 146097 + \$v * 365 + \$v / 4 - \$v / 100 + (153 * \$o + 2) / 5 + \$d - 1 - 719468) * 1440) + ([:tonum (\"1\" . [:pick \$b 0 2])] - 100) * 60 + ([:tonum (\"1\" . [:pick \$b 3 5])] - 100)) }; :foreach u in=[/ip hotspot user find where disabled=no and comment~\"^Kanary_C [0-9a-z]+;.*; k=[0-9]+\"] do={ :do { :local c [/ip hotspot user get \$u comment]; :local p [:find \$c \"; k=\"]; :local e [:find \$c \";\" (\$p + 1)]; :if ([:typeof \$e] = \"nil\") do={ :set e [:len \$c] }; :local k [:tonum [:pick \$c (\$p + 4) \$e]]; :if (([:typeof \$k] = \"num\") and (\$k <= \$nm)) do={ :local n [/ip hotspot user get \$u name]; /ip hotspot user set \$u disabled=yes comment=([:pick \$c 0 \$p] . \"; x=\" . [:pick \$c (\$p + 4) [:len \$c]]); :do { /ip hotspot active remove [find where user=\$n] } on-error={} } } on-error={} } }"; :local s [/system scheduler find where name="Kanaria-expire"]; :if ([:len $s] = 0) do={ /system scheduler add name="Kanaria-expire" interval=1m start-time=startup on-event=$ev comment="Kanaria hotspot cards: expiry" } else={ :if ([/system scheduler get [:pick $s 0] on-event] != $ev) do={ /system scheduler set [:pick $s 0] on-event=$ev } } } on-error={ :log warning "Kanaria cards: expiry scheduler failed" };
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C mhcbc2z2;" or (name="mhcbc2z2" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r1291,") } on-error={ :set t ($t . "e1291,") }
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C 70614486;" or (name="70614486" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :if ($n != "70614486") do={ /ip hotspot user set $u name="70614486" password="70614486" mac-address=00:00:00:00:00:00; :do { /ip hotspot active remove [find where user=$n] } on-error={} } }; :set t ($t . "b1288,") } on-error={ :set t ($t . "e1288,") }
:set t ($t . "\n"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9be8a22b2605ad689d18149126775973&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9be8a22b2605ad689d18149126775973&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
:foreach u in=[/ip hotspot user find where comment~"^Kanary_C"] do={ :do { :local c [/ip hotspot user get $u comment]; :local n [/ip hotspot user get $u name]; :local bi [/ip hotspot user get $u bytes-in]; :local bo [/ip hotspot user get $u bytes-out]; :local ut [/ip hotspot user get $u uptime]; :local ds [/ip hotspot user get $u disabled]; :set t ($t . "v" . $n . "|" . ($bi + $bo) . "|" . [:tostr $ut] . "|" . [:tostr $ds] . "|" . $c . "\n") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9be8a22b2605ad689d18149126775973&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9be8a22b2605ad689d18149126775973&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:foreach h in=[/ip hotspot active find] do={ :do { :set t ($t . "o" . [/ip hotspot active get $h user] . "\n") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9be8a22b2605ad689d18149126775973&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9be8a22b2605ad689d18149126775973&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:set t ($t . "c" . [/system clock get date] . "|" . [/system clock get time] . "|" . [:tostr [/system clock get gmt-offset]] . "\n");
:set t ($t . "end"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9be8a22b2605ad689d18149126775973&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9be8a22b2605ad689d18149126775973&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
}
