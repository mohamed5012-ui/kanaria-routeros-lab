# Kanaria hotspot cards (generated). Only users whose comment starts with Kanary_C are touched.
{
:global kanariaBeat; :if ([:typeof $kanariaBeat] != "num") do={ :set kanariaBeat 0 };
:local up true; :local t "";
:do { /system clock set date="2026-10-21" time="18:47:55" } on-error={ :log warning "Kanaria cards: clock not set" };
:do { /system scheduler remove [find where name="Kanaria-expire"] } on-error={};
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C 61727249;" or (name="61727249" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r82,") } on-error={ :set t ($t . "e82,") }
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C 43448412;" or (name="43448412" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r83,") } on-error={ :set t ($t . "e83,") }
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C 81156787;" or (name="81156787" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r84,") } on-error={ :set t ($t . "e84,") }
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C uk5rxu7w;" or (name="uk5rxu7w" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r85,") } on-error={ :set t ($t . "e85,") }
:set t ($t . "\n"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=8588caf6c2de8f81f121878983bbe6bd&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=8588caf6c2de8f81f121878983bbe6bd&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
:foreach u in=[/ip hotspot user find where comment~"^Kanary_C"] do={ :do { :local c [/ip hotspot user get $u comment]; :local n [/ip hotspot user get $u name]; :local bi [/ip hotspot user get $u bytes-in]; :local bo [/ip hotspot user get $u bytes-out]; :local ut [/ip hotspot user get $u uptime]; :local ds [/ip hotspot user get $u disabled]; :set t ($t . "v" . $n . "|" . ($bi + $bo) . "|" . [:tostr $ut] . "|" . [:tostr $ds] . "|" . $c . "\n") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=8588caf6c2de8f81f121878983bbe6bd&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=8588caf6c2de8f81f121878983bbe6bd&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:foreach h in=[/ip hotspot active find] do={ :do { :set t ($t . "o" . [/ip hotspot active get $h user] . "\n") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=8588caf6c2de8f81f121878983bbe6bd&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=8588caf6c2de8f81f121878983bbe6bd&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:set t ($t . "c" . [/system clock get date] . "|" . [/system clock get time] . "|" . [:tostr [/system clock get gmt-offset]] . "\n");
:set t ($t . "end"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=8588caf6c2de8f81f121878983bbe6bd&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=8588caf6c2de8f81f121878983bbe6bd&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
}
