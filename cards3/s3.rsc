# Kanaria hotspot cards (generated). Only users whose comment starts with Kanary_C are touched.
{
:global kanariaBeat; :if ([:typeof $kanariaBeat] != "num") do={ :set kanariaBeat 0 };
:local up true; :local t "";
:do { /system clock set date="2026-10-21" time="19:05:24" } on-error={ :log warning "Kanaria cards: clock not set" };
:do { /system scheduler remove [find where name="Kanaria-expire"] } on-error={};
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C 62452422;" or (name="62452422" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r1287,") } on-error={ :set t ($t . "e1287,") }
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C 70614486;" or (name="70614486" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r1288,") } on-error={ :set t ($t . "e1288,") }
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C 53670371;" or (name="53670371" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r1289,") } on-error={ :set t ($t . "e1289,") }
:do { :foreach u in=[/ip hotspot user find where (comment~"^Kanary_C t5aq39f6;" or (name="t5aq39f6" and comment="Kanary_C"))] do={ :local n [/ip hotspot user get $u name]; :do { /ip hotspot active remove [find where user=$n] } on-error={}; /ip hotspot user remove $u }; :set t ($t . "r1290,") } on-error={ :set t ($t . "e1290,") }
:set t ($t . "\n"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9d2a21dccb3633602918fcef3f2602f0&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9d2a21dccb3633602918fcef3f2602f0&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
:foreach u in=[/ip hotspot user find where comment~"^Kanary_C"] do={ :do { :local c [/ip hotspot user get $u comment]; :local n [/ip hotspot user get $u name]; :local bi [/ip hotspot user get $u bytes-in]; :local bo [/ip hotspot user get $u bytes-out]; :local ut [/ip hotspot user get $u uptime]; :local ds [/ip hotspot user get $u disabled]; :set t ($t . "v" . $n . "|" . ($bi + $bo) . "|" . [:tostr $ut] . "|" . [:tostr $ds] . "|" . $c . "\n") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9d2a21dccb3633602918fcef3f2602f0&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9d2a21dccb3633602918fcef3f2602f0&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:foreach h in=[/ip hotspot active find] do={ :do { :set t ($t . "o" . [/ip hotspot active get $h user] . "\n") } on-error={}; :if ([:len $t] > 3000) do={ :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9d2a21dccb3633602918fcef3f2602f0&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9d2a21dccb3633602918fcef3f2602f0&s=p" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t ""; }; };
:set t ($t . "c" . [/system clock get date] . "|" . [/system clock get time] . "|" . [:tostr [/system clock get gmt-offset]] . "\n");
:set t ($t . "end"); :if (($up) and ([:len $t] > 0)) do={ :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9d2a21dccb3633602918fcef3f2602f0&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :delay 2s; :do { /tool fetch url="https://10.0.2.2:8443/agent/cards?job=9d2a21dccb3633602918fcef3f2602f0&s=e" http-method=post http-header-field="X-Kanaria-Token: eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee,Content-Type: text/plain" http-data=$t check-certificate=yes output=none; :set kanariaBeat ($kanariaBeat + 1) } on-error={ :set up false } } }; :set t "";
}
